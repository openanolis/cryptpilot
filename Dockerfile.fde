# Builder stage - build RPM packages
FROM alibaba-cloud-linux-3-registry.cn-hangzhou.cr.aliyuncs.com/alinux3/alinux3:latest AS builder

# Replace mirrors for faster yum install
RUN sed -i -E 's|https?://mirrors.cloud.aliyuncs.com/|https://mirrors.aliyun.com/|g' /etc/yum.repos.d/*.repo
# Increase yum download speed
RUN sed -i 's/^max_parallel_downloads=.*/max_parallel_downloads=20/' /etc/yum.conf ; if ! grep -q '^max_parallel_downloads=' /etc/yum.conf; then sed -i '/^\[main\]$/a max_parallel_downloads=20' /etc/yum.conf; fi ;

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --no-modify-path --default-toolchain none

WORKDIR /code/

COPY rust-toolchain.toml .

# Install toolchain and cache it
RUN . "$HOME/.cargo/env" && rustup show

# Install build dependencies
RUN yum install -y git protobuf-devel gcc cmake clang clang-libs \
    cryptsetup-devel perl-IPC-Cmd device-mapper-devel fuse3-devel \
    rpmdevtools yum-utils && \
    yum clean all

COPY . .

# Setup RPM build tree
RUN rpmdev-setuptree

# Build RPM packages using the same process as rpm-build target
RUN . "$HOME/.cargo/env" && \
    # Create source tarball
    make create-tarball && \
    # Copy tarball to RPM build sources
    cp /tmp/cryptpilot-$(grep '^version' Cargo.toml | awk -F' = ' '{print $2}' | tr -d '"')-vendored-source.tar.gz ~/rpmbuild/SOURCES/ && \
    # Install build dependencies from spec file (like yum-builddep).
    # Only the fde subpackages are packaged by this image, so disable the
    # crypt/verity builds (and their BuildRequires) in the same spec.
    # (bcond disables need the underscore-prefixed _without_X macros.)
    yum-builddep -y --skip-unavailable ./cryptpilot.spec \
        --define '_without_crypt 1' --define '_without_verity 1' && \
    # Build RPM packages
    rpmbuild -ba ./cryptpilot.spec --define 'with_rustup 1' --without crypt --without verity


# e2fsprogs-builder - build a newer e2fsprogs (1.47.0) than alinux3 ships
# (1.46.0). e2fsck >= 1.47 is required to check/resize alinux4 guest images:
# their ext4 uses the casefold feature (FEATURE_C12) which 1.46.0 rejects
# with "Get a newer version of e2fsck!". alinux4's packaged e2fsprogs cannot
# simply be installed here (it needs glibc >= 2.33 while alinux3 has 2.28),
# so build from source against the container's own glibc.
FROM alibaba-cloud-linux-3-registry.cn-hangzhou.cr.aliyuncs.com/alinux3/alinux3:latest AS e2fsprogs-builder

# Replace mirrors for faster yum install
RUN sed -i -E 's|https?://mirrors.cloud.aliyuncs.com/|https://mirrors.aliyun.com/|g' /etc/yum.repos.d/*.repo
# Increase yum download speed
RUN sed -i 's/^max_parallel_downloads=.*/max_parallel_downloads=20/' /etc/yum.conf ; if ! grep -q '^max_parallel_downloads=' /etc/yum.conf; then sed -i '/^\[main\]$/a max_parallel_downloads=20' /etc/yum.conf; fi ;

RUN yum install -y gcc make gettext tar && \
    yum clean all

ARG E2FSPROGS_VERSION=1.47.0
ARG E2FSPROGS_SHA256=0b4fe723d779b0927fb83c9ae709bc7b40f66d7df36433bef143e41c54257084
RUN curl -fsSL -o /tmp/e2fsprogs.tar.gz \
        "https://kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.gz" && \
    echo "${E2FSPROGS_SHA256}  /tmp/e2fsprogs.tar.gz" | sha256sum -c - && \
    tar xf /tmp/e2fsprogs.tar.gz -C /tmp && \
    cd "/tmp/e2fsprogs-${E2FSPROGS_VERSION}" && \
    ./configure --libdir=/usr/lib64 && \
    make -j"$(nproc)" && \
    make install DESTDIR=/staging


# Release stage for cryptpilot-fde
FROM alibaba-cloud-linux-3-registry.cn-hangzhou.cr.aliyuncs.com/alinux3/alinux3:latest AS release-fde

# Replace mirrors for faster yum install
RUN sed -i -E 's|https?://mirrors.cloud.aliyuncs.com/|https://mirrors.aliyun.com/|g' /etc/yum.repos.d/*.repo
# Increase yum download speed
RUN sed -i 's/^max_parallel_downloads=.*/max_parallel_downloads=20/' /etc/yum.conf ; if ! grep -q '^max_parallel_downloads=' /etc/yum.conf; then sed -i '/^\[main\]$/a max_parallel_downloads=20' /etc/yum.conf; fi ;

# Copy RPM from builder
COPY --from=builder /root/rpmbuild/RPMS/x86_64/cryptpilot-fde-host-*.rpm /tmp/

# place guest RPM to root directory
COPY --from=builder /root/rpmbuild/RPMS/x86_64/cryptpilot-fde-guest-*.rpm /root/

# Install FDE package and its dependencies
# yum install will automatically resolve and install all dependencies from spec
# (incl. the libguestfs-tools-c weak dependency that provides virt-customize)
RUN yum install -y /tmp/cryptpilot-fde-host-*.rpm && \
    yum clean all && \
    rm -rf /var/cache/yum /tmp/*.rpm

# Replace the distro e2fsprogs 1.46.0 binaries with the 1.47.0 build (see
# e2fsprogs-builder above). The e2fsprogs tools are statically linked against
# their internal libs, so no shared libraries need to be copied. Only an
# allowlist is copied: e2fsprogs' make install also stages an unmaintained
# 2003-era "blkid" plus "fsck"/"findfs", which must not shadow the
# util-linux versions the image already has.
COPY --from=e2fsprogs-builder \
     /staging/sbin/e2fsck \
     /staging/sbin/fsck.ext2 \
     /staging/sbin/fsck.ext3 \
     /staging/sbin/fsck.ext4 \
     /staging/sbin/resize2fs \
     /staging/sbin/tune2fs \
     /staging/sbin/mke2fs \
     /staging/sbin/mkfs.ext2 \
     /staging/sbin/mkfs.ext3 \
     /staging/sbin/mkfs.ext4 \
     /staging/sbin/dumpe2fs \
     /usr/sbin/
COPY --from=e2fsprogs-builder /staging/etc/mke2fs.conf /etc/mke2fs.conf

# No libvirtd runs inside the container; drive virt-customize's qemu directly
# instead of through the libvirt backend.
ENV LIBGUESTFS_BACKEND=direct

CMD ["cryptpilot-fde-host"]
